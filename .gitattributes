* text=auto

# This fork stores most inherited assets as ordinary Git blobs. Applying the
# LFS clean filter to them makes a fresh checkout appear modified on AGNOS.
*.onnx -filter -diff -merge -text
*.svg -filter -diff -merge -text
*.png -filter -diff -merge -text
*.gif -filter -diff -merge -text
*.ttf -filter -diff -merge -text
*.otf -filter -diff -merge -text
*.wav -filter -diff -merge -text
selfdrive/car/tests/test_models_segs.txt -filter -diff -merge -text

# Keep only the existing pointer-backed assets in LFS; add new assets explicitly.
selfdrive/assets/fonts/Pretendard-Black.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-Bold.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-ExtraBold.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-ExtraLight.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-Light.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-Medium.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-Regular.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-SemiBold.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/fonts/Pretendard-Thin.ttf filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/icons_mici/carrot_cruse_gap_trimmed.png filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/icons_mici/carrot_wheel_org.png filter=lfs diff=lfs merge=lfs -text
selfdrive/assets/icons_mici/ego_vehicle_custom.png filter=lfs diff=lfs merge=lfs -text
selfdrive/modeld/models/driving_supercombo.onnx filter=lfs diff=lfs merge=lfs -text
system/hardware/tici/updater filter=lfs diff=lfs merge=lfs -text
